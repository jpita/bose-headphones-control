{
  "name": "bose-headphones-control",
  "version": "0.1.0",
  "description": "A local desktop control panel for compatible Bose headphones.",
  "author": "Gabriel Pita",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "check": "node --check electron/main.cjs",
    "build:backend": "./scripts/build-backend.sh",
    "make:mac": "npm run build:backend && electron-builder --mac dmg zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpita/bose-headphones-control.git"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jpita.bose-headphones-control",
    "productName": "Bose Headphones Control",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/bose-panel",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Bose Headphones Control uses Bluetooth to communicate with your paired Bose headphones."
      }
    }
  }
}
